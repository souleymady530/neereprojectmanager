# =============================================================================
# Neere PM – Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- Général ---
DEBUG=False
SECRET_KEY=change-me-avec-une-cle-aleatoire-longue
ALLOWED_HOSTS=project.mail.neerelab-technologysarl.com
SITE_URL=https://project.mail.neerelab-technologysarl.com

# --- Base de données PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
# psycopg v3 est utilisé (psycopg[binary]) — compatible django.db.backends.postgresql
DB_NAME=neere_pm
DB_USER=neere_user
DB_PASSWORD=motdepasse_fort_ici
DB_HOST=localhost
DB_PORT=5432

# --- Fichiers statiques et médias ---
STATIC_ROOT=/home/neere/project/django-redmine/neereprojectmanager/staticfiles
MEDIA_ROOT=/home/neere/project/django-redmine/neereprojectmanager/media

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@neerelab-technologysarl.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@neerelab-technologysarl.com

# =============================================================================
# DEV LOCAL – décommenter pour développement
# =============================================================================
